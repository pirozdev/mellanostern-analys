          <span class="fc-indicator state-OBSERVED">✓ IMF PortWatch: 2 transits/day confirmed (21 May)</span>
        </div>
      </div>

      <!-- NF2: Iran-US framework signed by June 15 -->
      <div class="forecast-card cat-diplomacy status-ACTIVE">
